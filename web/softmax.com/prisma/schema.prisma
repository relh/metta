generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(cuid(2))
  name           String?
  email          String?         @unique
  emailVerified  DateTime?
  image          String?
  accounts       Account[]
  authenticators Authenticator[]
  sessions       Session[]

  // Additional profile fields
  institution      String?
  profileCompleted Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Consent tracking — denormalized from ConsentRecord for fast reads on
  // every gated page load. Always written in the same $transaction as the
  // corresponding ConsentRecord insert, so they cannot drift.
  tosAcceptedAt         DateTime?
  tosVersion            String?
  consentServiceUpdates Boolean   @default(false)
  consentMarketing      Boolean   @default(false)

  machineTokens  MachineToken[]
  consentRecords ConsentRecord[]
}

model MachineToken {
  id             String    @id @default(cuid(2))
  userId         String
  name           String
  tokenHash      String    @unique
  createdAt      DateTime  @default(now())
  expirationTime DateTime
  lastUsedAt     DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model ConsentRecord {
  id          String   @id @default(cuid(2))
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentType String // "tos" | "comms_service" | "comms_marketing"
  granted     Boolean
  version     String? // for ToS: version string; null for comms
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId, consentType])
}

model GitHubTeamMember {
  userId String @id
  login  String
}
