{
  "name": "@softmax/website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "start": "next start",
    "build": "next build",
    "typegen": "next typegen",
    "type-check": "tsc --noEmit --pretty",
    "lint:prettier": "prettier --log-level warn --check .",
    "format": "prettier --write .",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "update-softmax-team": "tsx src/scripts/update-softmax-team.ts",
    "postinstall": "pnpm run db:generate && pnpm run typegen",
    "generate-api-types": "uv run ../../app_backend/scripts/export_openapi.py && openapi-typescript ../../app_backend/src/metta/app_backend/generated/openapi.json -o src/lib/api/generated/schema.d.ts && prettier --write src/lib/api/generated/schema.d.ts"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.0.7",
    "@prisma/adapter-pg": "^7",
    "@prisma/client": "^7",
    "@types/mdx": "^2.0.13",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.4",
    "jsonwebtoken": "^9.0.3",
    "next": "16.1.6",
    "next-auth": "5.0.0-beta.30",
    "next-mdx-remote": "^5.0.0",
    "next-safe-action": "^8.0.8",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "pg": "^8",
    "prisma": "^7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "remark-smartypants": "^3.0.2",
    "zod": "^4.3.6",
    "zod-form-data": "^3.0.0"
  },
  "devDependencies": {
    "@auth/prisma-adapter": "2.11.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.12",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.1.17",
    "@types/pg": "^8",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
