{
  "include": ["**/*.py"],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    ".venv",
    "**/.venv",
    "**/.bazel_output",
    "**/bazel-*",
    "**/build",
    "**/build-*",
    "dist",
    "**/.pytest_cache",
    "**/.mypy_cache",
    "**/.ruff_cache",
    "**/.benchmarks",
    "**/htmlcov",
    "**/test-results",
    "**/coverage-reports",
    "**/.next",
    "**/.turbo",
    "**/.pnpm",
    ".deps",
    "wandb",
    "train_dir",
    "outputs",
    "checkpoints",
    "replays",
    "tmp",
    "test_data",
    "packages/pufferlib-core",
    "external",
    "personal",
    "metta-research",
    "notebooks/.ipynb_checkpoints",
    "**/bindings/generated",
    "packages/cogames/README.py",
    "packages/cogames/tutorials",
    "**/*_pb2.pyi"
  ],
  "extraPaths": [
    "./agent/src",
    "./app_backend/src",
    "./common/src",
    "./packages/cogames/src",
    "./packages/cogames/tests/docsync",
    "./packages/mettagrid/python/src",
    "./packages/pufferlib-core/src"
  ],
  "stubPath": "./typings",
  "typeCheckingMode": "basic",
  "reportMissingModuleSource": false,
  "pythonVersion": "3.12",
  "venvPath": ".",
  "venv": ".venv"
}
