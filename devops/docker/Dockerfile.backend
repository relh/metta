FROM ubuntu:24.04

ARG GIT_COMMIT=""
ENV GIT_COMMIT=${GIT_COMMIT}

WORKDIR /workspace/metta

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    build-essential \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.9.5 /uv /uvx /bin/
ENV UV_HTTP_TIMEOUT=300

COPY . /workspace/metta

RUN uv python install
RUN uv run --no-sync python -m metta.setup.components.system_packages.bootstrap --non-interactive \
    && rm -rf /root/.cache/bazel-disk /root/.cache/bazelisk /root/.cache/bazel-repo /root/.cache/nim
RUN uv sync --frozen --package metta-app-backend --no-dev \
    && rm -rf /root/.cache/uv

CMD ["/bin/bash"]
