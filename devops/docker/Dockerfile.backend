FROM ubuntu:24.04

ARG GIT_COMMIT=""
ENV GIT_COMMIT=${GIT_COMMIT}

WORKDIR /workspace/metta

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    build-essential \
    ca-certificates \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.9.5 /uv /uvx /bin/
ENV UV_HTTP_TIMEOUT=300
ENV UV_TORCH_BACKEND=cpu

# --- Cacheable layers (invalidated only when deps/tooling change) ---
# Layer ordering matters for caching. Everything ABOVE "COPY . /workspace/metta"
# is cached across code-only changes. Deploy workflows use ECR registry cache
# (cache-from/cache-to in .github/actions/docker-build) so these cached layers
# persist across builds even on different runners. Moving any step below the
# COPY . line, or adding new COPY/RUN steps that depend on repo source code
# before it, will defeat the caching and regress build times.

COPY .python-version pyproject.toml uv.lock ./

RUN --mount=type=cache,id=backend-uv-cache,target=/root/.cache/uv \
    uv python install

# bootstrap.py is self-contained (no metta imports) so it can run from /tmp
# before the full repo is copied. Version files go to / for bootstrap to find.
COPY metta/setup/components/system_packages/bootstrap.py /tmp/bootstrap.py
COPY .bazelversion .bazeliskversion .nim-version .nimby-version /
RUN --mount=type=cache,id=backend-uv-cache,target=/root/.cache/uv \
    cd /tmp && uv run --no-sync python bootstrap.py --non-interactive \
    && rm -rf /root/.cache/bazel-disk /root/.cache/bazelisk /root/.cache/bazel-repo /root/.cache/nim

# Workspace member pyproject.toml stubs for dependency resolution.
# These are the transitive workspace deps of metta-app-backend:
#   app_backend -> common -> cogames -> mettagrid, plus gitta.
# Update this list if the workspace dependency chain changes.
COPY app_backend/pyproject.toml app_backend/
COPY common/pyproject.toml common/
COPY packages/cogames/pyproject.toml packages/cogames/
COPY packages/gitta/pyproject.toml packages/gitta/
COPY packages/mettagrid/pyproject.toml packages/mettagrid/

# First pass: install only external deps (no workspace packages).
# This layer is cached until pyproject.toml or uv.lock changes.
RUN --mount=type=cache,id=backend-uv-cache,target=/root/.cache/uv \
    uv sync --no-install-workspace --frozen --package metta-app-backend --no-dev

# --- Code layer (invalidated on every code change) ---
# Everything below here rebuilds on every code change. Keep this section minimal.

COPY . /workspace/metta

# Second pass: install workspace packages now that source code is present.
# This is the only step that re-runs on code-only changes (external deps are
# already installed and cached above). Includes mettagrid's Bazel build (~1-2 min).
RUN --mount=type=cache,id=backend-uv-cache,target=/root/.cache/uv \
    uv sync --frozen --package metta-app-backend --no-dev

CMD ["/bin/bash"]
