#!/bin/bash
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

CONFIG_FILE="$HOME/.metta/config.yaml"

if [ -f "$CONFIG_FILE" ]; then
    MODE=$(grep "push_hook_mode:" "$CONFIG_FILE" 2>/dev/null | awk '{print $2}' || echo "check")

    if [ "$MODE" = "none" ]; then
        exit 0
    fi
fi

check_cmd() {
  command -v "$1" > /dev/null 2>&1
  return $?
}

if ! check_cmd uv; then
    echo "uv not found. Consider running ./install.sh or 'uv run python -m metta.setup.components.system_packages.bootstrap'"
    exit 1
fi

if ! uv run --project "$REPO_ROOT" --no-sync metta run githooks pre-push; then
    exit 1
fi

exit 0
