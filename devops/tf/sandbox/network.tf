resource "aws_security_group" "sandbox_ssh" {
  name        = "metta-sandbox-ssh"
  description = "SSH access for metta coding sandboxes"

  ingress {
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

output "security_group_id" {
  value = aws_security_group.sandbox_ssh.id
}
